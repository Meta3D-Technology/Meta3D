{
  "name": "D4 convertTripoToMixamo: 完整转换 + 骨骼数 41→22 断言",
  "description": "打开 bone_converter demo → 点击「加载 Tripo 模型」→ 点击「Tripo→Mixamo 转换」→ 等待转换报告 → 断言骨骼数 41→22、Mixamo 骨名在列表中 → 截图（转换后模型渲染）→ 断言无 console 错误",
  "blocks": [
    { "type": "browser", "headless": true, "viewport": { "width": 1280, "height": 900 } },
    { "type": "navigate", "path": "/" },
    { "type": "sleep", "ms": 3000 },
    { "type": "click", "selector": "#btn-load-model", "timeout": 15000 },
    { "type": "waitText", "text": "骨骼数量:", "timeout": 60000 },
    { "type": "click", "selector": "#btn-convert", "timeout": 15000 },
    { "type": "waitText", "text": "转换完成", "timeout": 60000 },
    { "type": "assertText", "text": "骨骼数: 41 → 22", "timeout": 10000 },
    { "type": "assertText", "text": "重命名骨骼数:", "timeout": 10000 },
    { "type": "assertText", "text": "(22)", "timeout": 10000 },
    { "type": "assertText", "text": "mixamorigHips", "timeout": 10000 },
    { "type": "assertText", "text": "mixamorigRightHand", "timeout": 10000 },
    { "type": "screenshot", "name": "d4-convert-result" },
    { "type": "assertNoErrors" }
  ]
}
