{
  "name": "D3 renameBones: 加载 Tripo 模型 + 骨骼数量断言",
  "description": "打开 bone_converter demo → 点击「加载 Tripo 模型」→ 等待骨骼列表出现 → 断言页面显示骨骼数量 41 → 断言真实 Tripo Twist 骨名在列表中 → 截图",
  "blocks": [
    { "type": "browser", "headless": true, "viewport": { "width": 1280, "height": 900 } },
    { "type": "navigate", "path": "/" },
    { "type": "sleep", "ms": 3000 },
    { "type": "click", "selector": "#btn-load-model", "timeout": 15000 },
    { "type": "waitText", "text": "骨骼数量:", "timeout": 60000 },
    { "type": "assertText", "text": "骨骼数量: 41", "timeout": 10000 },
    { "type": "assertText", "text": "(41)", "timeout": 10000 },
    { "type": "assertText", "text": "R_UpperarmTwist01", "timeout": 10000 },
    { "type": "assertText", "text": "L_CalfTwist02", "timeout": 10000 },
    { "type": "assertText", "text": "Root", "timeout": 10000 },
    { "type": "screenshot", "name": "d3-model-loaded" }
  ]
}
