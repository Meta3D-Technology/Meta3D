  },
  "dependencies": {
    "three": "0.159.0"
  },
  "devDependencies": {
    "@types/three": "0.158.1",
    "cross-env": "^7.0.3",
    "html-webpack-plugin": "^5.6.4",
    "ts-loader": "^9.2.6",
    "typescript": "^5.8.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.0",
    "jest-cucumber": "^4.1.0"
  }
}
