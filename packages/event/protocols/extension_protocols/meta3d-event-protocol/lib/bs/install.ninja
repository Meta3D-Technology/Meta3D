rescript = 1
rule cp
  command = cmd.exe /C copy /Y $i $out >NUL
rule touch
 command = cmd.exe /C type nul >>$out & copy $out+,, >NUL
o StateType-Meta3dEventProtocol.cmi : cp ..\bs\src\state\StateType-Meta3dEventProtocol.cmi
o StateType-Meta3dEventProtocol.cmj : cp ..\bs\src\state\StateType-Meta3dEventProtocol.cmj
o StateType-Meta3dEventProtocol.cmt : cp ..\bs\src\state\StateType-Meta3dEventProtocol.cmt
o StateType.res : cp ..\..\src\state\StateType.res
o EventType-Meta3dEventProtocol.cmi : cp ..\bs\src\service\EventType-Meta3dEventProtocol.cmi
o EventType-Meta3dEventProtocol.cmj : cp ..\bs\src\service\EventType-Meta3dEventProtocol.cmj
o EventType-Meta3dEventProtocol.cmt : cp ..\bs\src\service\EventType-Meta3dEventProtocol.cmt
o EventType.res : cp ..\..\src\service\EventType.res
o BrowserType-Meta3dEventProtocol.cmi : cp ..\bs\src\service\BrowserType-Meta3dEventProtocol.cmi
o BrowserType-Meta3dEventProtocol.cmj : cp ..\bs\src\service\BrowserType-Meta3dEventProtocol.cmj
o BrowserType-Meta3dEventProtocol.cmt : cp ..\bs\src\service\BrowserType-Meta3dEventProtocol.cmt
o BrowserType.res : cp ..\..\src\service\BrowserType.res
o ServiceType-Meta3dEventProtocol.cmi : cp ..\bs\src\service\ServiceType-Meta3dEventProtocol.cmi
o ServiceType-Meta3dEventProtocol.cmj : cp ..\bs\src\service\ServiceType-Meta3dEventProtocol.cmj
o ServiceType-Meta3dEventProtocol.cmt : cp ..\bs\src\service\ServiceType-Meta3dEventProtocol.cmt
o ServiceType.res : cp ..\..\src\service\ServiceType.res
o ActionContributeType-Meta3dEventProtocol.cmi : cp ..\bs\src\contribute\ActionContributeType-Meta3dEventProtocol.cmi
o ActionContributeType-Meta3dEventProtocol.cmj : cp ..\bs\src\contribute\ActionContributeType-Meta3dEventProtocol.cmj
o ActionContributeType-Meta3dEventProtocol.cmt : cp ..\bs\src\contribute\ActionContributeType-Meta3dEventProtocol.cmt
o ActionContributeType.res : cp ..\..\src\contribute\ActionContributeType.res
o Meta3dEventProtocol.cmi : cp ..\bs\Meta3dEventProtocol.cmi
o Meta3dEventProtocol.cmj : cp ..\bs\Meta3dEventProtocol.cmj
o Meta3dEventProtocol.cmt : cp ..\bs\Meta3dEventProtocol.cmt
build install.stamp : touch StateType-Meta3dEventProtocol.cmi StateType-Meta3dEventProtocol.cmj EventType-Meta3dEventProtocol.cmi EventType-Meta3dEventProtocol.cmj BrowserType-Meta3dEventProtocol.cmi BrowserType-Meta3dEventProtocol.cmj ServiceType-Meta3dEventProtocol.cmi ServiceType-Meta3dEventProtocol.cmj ActionContributeType-Meta3dEventProtocol.cmi ActionContributeType-Meta3dEventProtocol.cmj Meta3dEventProtocol.cmi Meta3dEventProtocol.cmj
