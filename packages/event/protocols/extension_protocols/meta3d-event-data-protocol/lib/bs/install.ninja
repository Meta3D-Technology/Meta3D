rescript = 1
rule cp
  command = cmd.exe /C copy /Y $i $out >NUL
rule touch
 command = cmd.exe /C type nul >>$out & copy $out+,, >NUL
o StateType-Meta3dEventDataProtocol.cmi : cp ..\bs\src\state\StateType-Meta3dEventDataProtocol.cmi
o StateType-Meta3dEventDataProtocol.cmj : cp ..\bs\src\state\StateType-Meta3dEventDataProtocol.cmj
o StateType-Meta3dEventDataProtocol.cmt : cp ..\bs\src\state\StateType-Meta3dEventDataProtocol.cmt
o StateType.res : cp ..\..\src\state\StateType.res
o ServiceType-Meta3dEventDataProtocol.cmi : cp ..\bs\src\service\ServiceType-Meta3dEventDataProtocol.cmi
o ServiceType-Meta3dEventDataProtocol.cmj : cp ..\bs\src\service\ServiceType-Meta3dEventDataProtocol.cmj
o ServiceType-Meta3dEventDataProtocol.cmt : cp ..\bs\src\service\ServiceType-Meta3dEventDataProtocol.cmt
o ServiceType.res : cp ..\..\src\service\ServiceType.res
o Meta3dEventDataProtocol.cmi : cp ..\bs\Meta3dEventDataProtocol.cmi
o Meta3dEventDataProtocol.cmj : cp ..\bs\Meta3dEventDataProtocol.cmj
o Meta3dEventDataProtocol.cmt : cp ..\bs\Meta3dEventDataProtocol.cmt
build install.stamp : touch StateType-Meta3dEventDataProtocol.cmi StateType-Meta3dEventDataProtocol.cmj ServiceType-Meta3dEventDataProtocol.cmi ServiceType-Meta3dEventDataProtocol.cmj Meta3dEventDataProtocol.cmi Meta3dEventDataProtocol.cmj
